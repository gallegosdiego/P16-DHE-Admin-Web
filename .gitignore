# Respaldos que genera repair-public-storage-link.php cuando no puede crear
# el enlace simbolico (p. ej. Windows sin permisos). Son artefactos de
# ejecucion, nunca codigo.
api/public/storage_backup_*/
api/public/storage

# Build
frontend/out/
frontend/test-results/
frontend/playwright-report/

# Misc
*.bak
*.tmp
.codex-remote-attachments/

# --- Credenciales y volcados de sesion (ruta de remediacion P1.1) ---
# Motivo: cookies.txt con una sesion viva de produccion llego a un repo publico.
cookies.txt
*.cookies
cookie*.txt
cookies-*.txt
*.har
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
